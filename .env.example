RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard > Webhooks (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Inbox that receives contact-form messages (falls back to Admin > Settings > Support email)
SUPPORT_INBOX_EMAIL=

# Public storefront URL used in e-mail links (newsletter confirmation etc.). Set to the live site.
SITE_URL=
# Optional secret for hashing consent IPs (falls back to JWT_SECRET)
NEWSLETTER_HASH_SECRET=
