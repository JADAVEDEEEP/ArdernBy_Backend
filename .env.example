RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard > Webhooks (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Inbox that receives contact-form messages (falls back to Admin > Settings > Support email)
SUPPORT_INBOX_EMAIL=

# Public storefront URL used in e-mail links (newsletter confirmation etc.). Set to the live site.
SITE_URL=
# Optional secret for hashing consent IPs (falls back to JWT_SECRET)
NEWSLETTER_HASH_SECRET=
# Public address of this API, used in the one-click unsubscribe header (RFC 8058).
# Production: https://ardernby-backend.onrender.com   (spelled "ardernby"; see docs/NEWSLETTER_DEPLOYMENT.md)
API_PUBLIC_URL=
# Browser origins allowed to call the API (comma separated, exact scheme + host). Production site: https://kovenik.in
# WARNING: list EVERY address the storefront is served from (www.kovenik.in, ardenby.vercel.app) or those shoppers are blocked.
CORS_ORIGINS=

# ---- Newsletter campaigns (see docs/NEWSLETTER_CAMPAIGNS.md) ----
# Postal address printed in every campaign email footer. The PIN code is NOT guessed: real sends stay blocked until it is set.
NEWSLETTER_POSTAL_ADDRESS=Krishna Bunglow 1, New Ranip, Ahmedabad
NEWSLETTER_POSTAL_PIN=
# Gentle sending defaults: emails per run, pause between emails (ms), emails per UTC day (0 = no limit of our own), run time budget (ms)
NEWSLETTER_BATCH_SIZE=20
NEWSLETTER_SEND_DELAY_MS=1000
NEWSLETTER_DAILY_LIMIT=250
NEWSLETTER_TICK_BUDGET_MS=25000
# Long random secrets (16+ characters) for two machine endpoints. Unset = the endpoint answers 503.
BREVO_WEBHOOK_SECRET=
NEWSLETTER_WORKER_SECRET=
